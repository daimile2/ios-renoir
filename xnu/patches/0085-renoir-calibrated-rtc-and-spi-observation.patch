+/* Separate RTC observer APID; never issue commands on the key APIDs here. */
+static vm_offset_t rtc_obs;
+static uint16_t rtc_apid = KEYS_NO_APID;
+static uint64_t rtc_offset_ms, rtc_epoch_seconds, rtc_sample_uptime;
+static bool rtc_ready;
+static int rtc_hw_seconds(uint64_t *seconds);
+
+void renoir_rtc_init(void);
+int renoir_rtc_seconds(uint64_t *seconds);
+
+static bool
+rtc_read(uint16_t addr, uint8_t *out)
+{
+	uint32_t off = 0x80u * rtc_apid;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(rtc_obs + off) = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = keys_rd(rtc_obs, off + 8);
+		if (status & 1u) {
+			if (status & 0x0eu) return false;
+			*out = (uint8_t)keys_rd(rtc_obs, off + 0x18);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+void
+renoir_rtc_init(void)
+{
+	int enabled = 0;
+	(void)PE_parse_boot_argn("renoirrtc", &enabled, sizeof(enabled));
+	if (!enabled || !PE_parse_boot_argn("rtc_offset_ms", &rtc_offset_ms,
+	    sizeof(rtc_offset_ms)) || rtc_offset_ms < 1577836800000ULL ||
+	    rtc_offset_ms > 4102444800000ULL) {
+		printf("RENOIR RTC: disabled or missing calibration; PMIC unchanged\n");
+		return;
+	}
+	vm_offset_t core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	vm_offset_t cfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	rtc_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!core || !cfg || !rtc_obs) return;
+	uint32_t version = keys_rd(core, 0), count = keys_rd(core, 4) & 0x7ff;
+	if (version < 0x50000000u || version >= 0x70000000u || !count || count > 512) return;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(core, 0x900 + 4 * i);
+		if (map && ((map >> 8) & 0xfff) == 0x061 &&
+		    (rtc_apid == KEYS_NO_APID || (keys_rd(cfg, 0x700 + 4 * i) & 7) == 0))
+			rtc_apid = (uint16_t)i;
+	}
+	uint8_t ctrl = 0;
+	if (rtc_apid == KEYS_NO_APID || !rtc_read(0x6146, &ctrl) || !(ctrl & 0x80)) {
+		rtc_apid = KEYS_NO_APID;
+		printf("RENOIR RTC: unavailable or disabled; PMIC unchanged\n");
+		return;
+	}
+	if (!rtc_hw_seconds(&rtc_epoch_seconds)) {
+		printf("RENOIR RTC: coherent sample failed; PMIC unchanged\n");
+		return;
+	}
+	clock_get_uptime(&rtc_sample_uptime);
+	rtc_ready = true;
+	printf("RENOIR RTC: calibrated sample epoch=%llu apid=%u; monotonic continuation\n",
+	    rtc_epoch_seconds, rtc_apid);
+}
+
+static int
+rtc_hw_seconds(uint64_t *seconds)
+{
+	if (rtc_apid == KEYS_NO_APID) return 0;
+	/* Repeat full reads until coherent, including a possible low-byte rollover. */
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		uint32_t value[2] = {0, 0};
+		for (unsigned n = 0; n < 2; ++n) {
+			for (unsigned b = 0; b < 4; ++b) {
+				uint8_t v;
+				if (!rtc_read((uint16_t)(0x6148 + b), &v)) return 0;
+				value[n] |= (uint32_t)v << (8 * b);
+			}
+		}
+		if (value[0] == value[1]) {
+			*seconds = (rtc_offset_ms + (uint64_t)value[0] * 1000) / 1000;
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* Never access SPMI from platform time callbacks or compete with key polling. */
+int
+renoir_rtc_seconds(uint64_t *seconds)
+{
+	uint64_t now, elapsed_ns;
+	if (!rtc_ready) return 0;
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now - rtc_sample_uptime, &elapsed_ns);
+	*seconds = rtc_epoch_seconds + elapsed_ns / NSEC_PER_SEC;
+	return 1;
+}
