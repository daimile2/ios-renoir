+	uint32_t fw = keys_rd(se, 0x68);
+	printf("RENOIR SPI: read-only fw=%#x protocol=%u status=%#x clk=%#x tx=%#x rx=%#x hw0=%#x hw1=%#x; no touch events\n",
+	    fw, (fw >> 8) & 0xff, keys_rd(se, 0x40), keys_rd(se, 0x60),
+	    keys_rd(se, 0x800), keys_rd(se, 0x804), keys_rd(se, 0xe24), keys_rd(se, 0xe28));
 }
 
