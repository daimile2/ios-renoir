+#if defined(ARM64_BOARD_CONFIG_SWEET)
+void renoir_timezone_init(void);
+void
+renoir_timezone_init(void)
+{
+	int enabled = 0;
+	if (!PE_parse_boot_argn("renoirshanghai", &enabled, sizeof(enabled)) || !enabled) return;
+	vfs_context_t ctx = vfs_context_current();
+	const char *target = "/usr/share/zoneinfo.default/Asia/Shanghai";
+	const char *link = "/private/var/db/timezone/localtime";
+	const char *temporary = "/private/var/db/timezone/.renoir-localtime";
+	vnode_t zone = NULLVP, old = NULLVP;
+	int error = vnode_lookup(target, 0, &zone, ctx);
+	if (error) { printf("RENOIR TZ: Shanghai zone missing error=%d\n",error); return; }
+	if (vnode_vtype(zone) != VREG) { vnode_put(zone); return; }
+	error = vnode_lookup(link, 0, &old, ctx);
+	if (!error) {
+		bool same = old == zone;
+		vnode_put(old);
+		if (same) { vnode_put(zone); printf("RENOIR TZ: already Asia/Shanghai\n"); return; }
+	}
+	vnode_put(zone);
+	/* Refuse to replace any regular file or directory at this config path. */
+	error = vnode_lookup(link, VNODE_LOOKUP_NOFOLLOW, &old, ctx);
+	if (error) { printf("RENOIR TZ: localtime lookup error=%d\n",error); return; }
+	bool symlink_only = vnode_vtype(old) == VLNK;
+	vnode_put(old);
+	if (!symlink_only) { printf("RENOIR TZ: localtime is not a symlink; unchanged\n"); return; }
+	error = symlinkat_internal(ctx,(user_addr_t)target,AT_FDCWD,
+	    (user_addr_t)temporary,UIO_SYSSPACE);
+	if (!error) error = renameat_internal(ctx,AT_FDCWD,(user_addr_t)temporary,
+	    AT_FDCWD,(user_addr_t)link,UIO_SYSSPACE,0);
+	printf("RENOIR TZ: Asia/Shanghai atomic config error=%d; RTC unchanged\n",error);
+}
+#endif
