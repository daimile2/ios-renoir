+/* No ring programming, START or doorbells: exercise only the command
+ * allocator of one pristine dynamic group. Linux DE_ALLOC completion does
+ * NOT update the hardware state field; require a fresh control status bit.
+ * Poll the source status with the output IRQ masked (no GIC handler yet). */
+static bool
+renoir_gpi_command(vm_offset_t regs, uint32_t base, unsigned channel,
+    bool event, unsigned opcode)
+{
+	uint32_t status=base+(event?0x3094:0x3090);
+	uint32_t clear=base+(event?0x30a4:0x30a0);
+	uint32_t bit=event?1u:(1u<<channel);
+	uint32_t context=base+(event?0x1000:0x80*channel);
+	/* Only clear our own command-completion bit. */
+	renoir_spi_wr(regs,clear,bit);
+	if(keys_rd(regs,status)&bit) {
+		printf("RENOIR GPI CMD: stale status cannot clear; command withheld\n");
+		return false;
+	}
+	renoir_spi_wr(regs,base+(event?0x3010:0x3008),
+	    (opcode<<24)|(event?0:channel));
+	unsigned us;
+	for(us=0;us<250000;us+=10) {
+		if(keys_rd(regs,status)&bit) break;
+		delay(10);
+	}
+	uint32_t state=(keys_rd(regs,context)>>20)&15;
+	bool fresh=us<250000;
+	if(fresh) renoir_spi_wr(regs,clear,bit);
+	printf("RENOIR GPI CMD: %s ch=%u op=%u fresh=%d state=%u wait-us=%u error=%#x\n",
+	    event?"EV":"CH",channel,opcode,fresh,state,us,keys_rd(regs,base+0x3200));
+	/* Downstream driver treats completed DEALLOC as software state0 even
+	 * if the hardware context still reports ALLOCATED. */
+	return fresh && (opcode==10 || state==1);
+}
+
+static void
+renoir_gpi_allocator(vm_offset_t regs)
+{
+	int enabled=0;
+	(void)PE_parse_boot_argn("renoirgpialloc",&enabled,sizeof(enabled));
+	if(!enabled) return;
+	unsigned group;
+	uint32_t base=0;
+	for(group=1;group<=6;++group) {
+		base=0x10000+group*0x4000;
+		bool pristine=true;
+		/* Exclude active, configured or pending groups. Check both rings
+		 * and event context, scratch, source status and IRQ masks. */
+		for(unsigned c=0;c<3;++c) {
+			uint32_t off=base+(c==2?0x1000:c*0x80);
+			for(unsigned r=0;r<=0x34;r+=4)
+				if(keys_rd(regs,off+r)) pristine=false;
+		}
+		for(unsigned c=0;c<2;++c)
+			for(unsigned r=0x60;r<=0x6c;r+=4)
+				if(keys_rd(regs,base+c*0x80+r)) pristine=false;
+		const uint32_t checks[]={0x3080,0x3088,0x3090,0x3094,
+		    0x3098,0x309c,0x30b0,0x30b8,0x3100,0x3108,0x3118,0x3120};
+		for(unsigned i=0;i<sizeof(checks)/sizeof(checks[0]);++i)
+			if(keys_rd(regs,base+checks[i])) pristine=false;
+		if(pristine) break;
+	}
+	if(group>6) {
+		printf("RENOIR GPI ALLOC: no pristine dynamic group; unchanged\n");
+		return;
+	}
+	printf("RENOIR GPI ALLOC: group=%u pristine; output IRQ masked; no ring/START/doorbell/DMA\n",group);
+	/* Keep type output mask zero; source masks collect command status.
+	 * No MSI routing, global IRQ, shared GPI reset or firmware writes. */
+	renoir_spi_wr(regs,base+0x3098,3);
+	renoir_spi_wr(regs,base+0x309c,1);
+	bool ev=false, tx=false, rx=false, ok=true;
+	ev=renoir_gpi_command(regs,base,0,true,0);
+	if(ev) tx=renoir_gpi_command(regs,base,0,false,0);
+	if(tx) rx=renoir_gpi_command(regs,base,1,false,0);
+	ok=ev&&tx&&rx;
+	/* No STOP/RESET: no channel was started. On timeout ownership is
+	 * uncertain; do not retry another group or reset shared hardware. */
+	if(rx) ok=renoir_gpi_command(regs,base,1,false,10)&&ok;
+	if(tx) ok=renoir_gpi_command(regs,base,0,false,10)&&ok;
+	if(ev) ok=renoir_gpi_command(regs,base,0,true,10)&&ok;
+	renoir_spi_wr(regs,base+0x3098,0);
+	renoir_spi_wr(regs,base+0x309c,0);
+	printf("RENOIR GPI ALLOC: group=%u allocate/release=%d ev=%d tx=%d rx=%d; failed commands require reboot; DMA never submitted\n",
+	    group,ok,ev,tx,rx);
 }
 
