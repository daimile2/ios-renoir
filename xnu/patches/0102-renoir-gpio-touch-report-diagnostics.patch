+/* Vendor star-r-oss reads 63 touch + 28 gesture - 1 prefix bytes.
+ * Diagnostics only: never inject unvalidated coordinates into HID. */
+static void
+renoir_gpio_report_poll(void)
+{
+	if(!renoir_report_tlmm) return;
+	uint8_t tx[99]={1,0xa0,0,90},rx[99]={0},buf[91]={1};
+	static unsigned polls,good,bad,printed;
+	static uint8_t previous[62];
+	++polls;
+	bool transfer=renoir_gpio_spi_xfer(renoir_report_tlmm,tx,rx,sizeof(tx));
+	bool crc=renoir_fts_crc(rx+7,90)==(uint16_t)(rx[97]|(rx[98]<<8));
+	if(!transfer || (rx[3]&0xa0) || !crc) {
+		if(++bad<=3 || bad%100==0)
+			printf("RENOIR GPIO REPORT: rejected poll=%u status=%#x crc=%d bad=%u\n",polls,rx[3],crc,bad);
+	} else {
+		++good;
+		memcpy(buf+1,rx+7,90);
+		unsigned count=buf[2]&15;
+		bool changed=memcmp(previous,buf+1,sizeof(previous))!=0;
+		memcpy(previous,buf+1,sizeof(previous));
+		if(changed && (printed<300 || polls%100==0)) {
+			++printed;
+			printf("RENOIR GPIO REPORT: poll=%u count=%u header=%02x/%02x IRQ31=%u CRC=1 NO HID\n",
+			    polls,count,buf[1],buf[2],keys_rd(renoir_report_tlmm,31*0x1000+4)&1);
+			if(count<=10) for(unsigned i=0;i<10;++i) {
+				unsigned off=6*i,id=buf[5+off]>>4;
+				if(id>=10) break;
+				unsigned x=((buf[3+off]&15)<<11)+(buf[4+off]<<3)+((buf[7+off]&0xe0)>>5);
+				unsigned y=((buf[5+off]&15)<<11)+(buf[6+off]<<3)+((buf[7+off]&0x1c)>>2);
+				unsigned flag=buf[3+off]>>6;
+				printf("RENOIR GPIO POINT: id=%u flag=%u x=%u y=%u in1080x2400=%d raw=%02x/%02x/%02x/%02x/%02x/%02x\n",
+				    id,flag,x,y,x<1080&&y<2400,buf[3+off],buf[4+off],buf[5+off],buf[6+off],buf[7+off],buf[8+off]);
+			}
+		}
+	}
+	if(polls%100==0) printf("RENOIR GPIO REPORT SUMMARY: polls=%u crc-good=%u rejected=%u; NO HID\n",polls,good,bad);
+}
