+static uint16_t
+renoir_fts_crc(const uint8_t *data, unsigned len)
+{
+	uint16_t crc=0xffff;
+	for(unsigned i=0;i<len;++i) {
+		crc^=data[i];
+		for(unsigned bit=0;bit<8;++bit)
+			crc=(crc&1)?(crc>>1)^0x8408:crc>>1;
+	}
+	return crc;
+}
