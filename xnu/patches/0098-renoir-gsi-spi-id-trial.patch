+/* Bounded GSI SPI ID probe. Register/TRE layouts from pinned Xiaomi
+ * spi-msm-geni.c/msm-geni-se.c; FTS framing cross-checked with HackiOS
+ * 8e611870 redwood_goodix.c. No firmware upload or chip writes. */
+static vm_offset_t renoir_spi_trial_se,renoir_spi_trial_tlmm;
+static const uint32_t renoir_spi_trial_offsets[]={0x20,0x24,0x28,0x258,0x614,0x644,0xe18,0xe1c,0xe30};
+static uint32_t renoir_spi_trial_saved[9],renoir_spi_trial_pins[4];
+static bool renoir_spi_trial_changed;
+
+static bool
+renoir_gsi_spi_setup(void)
+{
+	vm_offset_t se=ml_io_map(0x988000,0x4000),tlmm=ml_io_map(0xf100000,0x20000);
+	vm_offset_t gcc=ml_io_map(0x100000,0x53000);
+	if(!se || !tlmm || !gcc) return false;
+	/* Only known XO parent/divider configuration; no root reparenting. */
+	if((keys_rd(gcc,0x17274)&0x71f)!=0 || keys_rd(se,0x7c)!=0 ||
+	    (keys_rd(gcc,0x1726c)&0x80000000u) || (keys_rd(se,0x40)&0x1001) ||
+	    !(keys_rd(tlmm,30*0x1000+4)&1)) {
+		printf("RENOIR GSI SPI: clock/state/reset guard failed; no SPI\n");return false;
+	}
+	renoir_spi_trial_se=se;renoir_spi_trial_tlmm=tlmm;
+	for(unsigned i=0;i<9;++i) renoir_spi_trial_saved[i]=keys_rd(se,renoir_spi_trial_offsets[i]);
+	for(unsigned i=0;i<4;++i) renoir_spi_trial_pins[i]=keys_rd(tlmm,(20+i)*0x1000);
+	renoir_spi_trial_changed=true;
+	for(unsigned i=0;i<4;++i)
+		renoir_spi_wr(tlmm,(20+i)*0x1000,(renoir_spi_trial_pins[i]&~0x3ffu)|0x84u);
+	renoir_spi_wr(se,0x28,keys_rd(se,0x28)|0x7f);
+	renoir_spi_wr(se,0xe30,keys_rd(se,0xe30)|0xf);
+	renoir_spi_wr(se,0x24,0x7f);renoir_spi_wr(se,0x20,1);
+	renoir_spi_wr(se,0xe1c,0);
+	renoir_spi_wr(se,0x614,keys_rd(se,0x614)&~0x4c000001u);
+	renoir_spi_wr(se,0x644,keys_rd(se,0x644)&~1u);
+	renoir_spi_wr(se,0x618,0xffffffff);renoir_spi_wr(se,0x648,0xffffffff);
+	renoir_spi_wr(se,0xc44,0xffffffff);renoir_spi_wr(se,0xd44,0xffffffff);
+	renoir_spi_wr(se,0x258,keys_rd(se,0x258)|1);
+	renoir_spi_wr(se,0xe18,keys_rd(se,0xe18)|0xf);
+	bool ok=(keys_rd(se,0x258)&1) && (keys_rd(se,0xe18)&15)==15;
+	for(unsigned i=0;i<4;++i) if((keys_rd(tlmm,(20+i)*0x1000)&0x3ff)!=0x84) ok=false;
+	printf("RENOIR GSI SPI: config readback=%d mode=%#x events=%#x pins=84/84/84/84 requested; XO19.2MHz/div4 mode0 bits8\n",ok,keys_rd(se,0x258),keys_rd(se,0xe18));
+	return ok;
+}
+
+static void
+renoir_gsi_spi_restore(void)
+{
+	if(!renoir_spi_trial_changed) return;
+	if(keys_rd(renoir_spi_trial_se,0x40)&0x1001) {
+		printf("RENOIR GSI SPI: engine busy; retain trial config until reboot\n");return;
+	}
+	for(unsigned i=0;i<9;++i) renoir_spi_wr(renoir_spi_trial_se,renoir_spi_trial_offsets[i],renoir_spi_trial_saved[i]);
+	for(unsigned i=0;i<4;++i) renoir_spi_wr(renoir_spi_trial_tlmm,(20+i)*0x1000,renoir_spi_trial_pins[i]);
+	renoir_spi_trial_changed=false;
+	printf("RENOIR GSI SPI: idle configuration/pins restored after channel RESET\n");
+}
+
+/* -1: uncertain DMA, no more descriptors; 0: completed but ID invalid;
+ * 1: both registers CRC-valid and expected. Event slots2..5, no wrap. */
+static int
+renoir_gsi_spi_ids(vm_offset_t regs,uint32_t base)
+{
+	if(!renoir_gsi_spi_setup()) return -1;
+	uint32_t *event=(uint32_t *)(renoir_dma_va+0x4000);
+	uint32_t *tx=(uint32_t *)(renoir_dma_va+0x5000);
+	uint32_t *rx=(uint32_t *)(renoir_dma_va+0x6000);
+	uint8_t ids[2]={0};bool valid[2]={false,false};
+	for(unsigned trial=0;trial<2;++trial) {
+		unsigned slot=2+trial*3;
+		uint8_t *out=(uint8_t *)(renoir_dma_va+0x7000+trial*0x100);
+		uint8_t *in=(uint8_t *)(renoir_dma_va+0x8000+trial*0x100);
+		out[0]=trial?0x9f:0xa3;out[1]=0xa0;out[2]=0;out[3]=1;
+		/* CONFIG, GO full-duplex CS0, TX DMA IEOT. RX event automatic. */
+		tx[4*slot]=0x03000004;tx[4*slot+1]=0;tx[4*slot+2]=4;tx[4*slot+3]=0x220001;
+		tx[4*slot+4]=3;tx[4*slot+5]=0;tx[4*slot+6]=10;tx[4*slot+7]=0x200801;
+		tx[4*slot+8]=0x103000+trial*0x100;tx[4*slot+9]=0;tx[4*slot+10]=10;tx[4*slot+11]=0x100200;
+		rx[4*trial]=0x104000+trial*0x100;rx[4*trial+1]=0;rx[4*trial+2]=10;rx[4*trial+3]=0x100000;
+		/* Clean CPU-owned descriptors/TX only, never clean HW event/RX pages. */
+		clean_dcache64(renoir_dma_pa+0x5000,0x3000,TRUE);
+		__asm__ volatile("dsb sy" ::: "memory");
+		delay(150);
+		renoir_spi_wr(regs,base+0x2000,0x101000+16*(slot+3));
+		renoir_spi_wr(regs,base+0x2008,0x102000+16*(trial+1));
+		uint32_t expected=0x100000+16*(4+trial*2),rp=0;unsigned us;
+		for(us=0;us<250000;us+=100) {
+			rp=keys_rd(regs,base+0x1010);
+			if(rp==expected || (keys_rd(renoir_dma_cb,0x58)&RENOIR_SMMU_FSR_FAULT)) break;
+			delay(100);
+		}
+		flush_dcache64(renoir_dma_pa+0x4000,0x1000,TRUE);
+		flush_dcache64(renoir_dma_pa+0x8000,0x1000,TRUE);
+		bool seen[2]={false,false},good=rp==expected;
+		for(unsigned j=0;j<2;++j) {
+			uint32_t *e=event+4*(2+2*trial+j),ch=e[3]>>24,code=e[2]>>24;
+			uint32_t ptr=ch==0?0x101000+16*(slot+2):0x102000+16*trial;
+			bool eok=ch<2 && !seen[ch] && e[0]==ptr && !e[1] &&
+			    ((e[3]>>16)&255)==0x22 && !(e[3]&0xffff) && code==2 && (e[2]&0xffffff)==10;
+			if(ch<2) seen[ch]=true;
+			good=good&&eok;
+			printf("RENOIR GSI SPI EVENT: reg=%#x slot=%u valid=%d data=%08x/%08x/%08x/%08x\n",out[0],2+2*trial+j,eok,e[0],e[1],e[2],e[3]);
+		}
+		for(unsigned j=64;j<1024;++j) if(event[j]!=0xa5a5a5a5) good=false;
+		if(keys_rd(renoir_dma_cb,0x58)&RENOIR_SMMU_FSR_FAULT) good=false;
+		printf("RENOIR GSI SPI DMA: reg=%#x complete=%d wait-us=%u rp=%#x FSR=%#x MIRQ=%#x SIRQ=%#x state=%#x rx=%02x/%02x/%02x/%02x/%02x/%02x/%02x/%02x/%02x/%02x\n",out[0],good,us,rp,keys_rd(renoir_dma_cb,0x58),keys_rd(renoir_spi_trial_se,0x610),keys_rd(renoir_spi_trial_se,0x640),keys_rd(renoir_spi_trial_se,0x40),in[0],in[1],in[2],in[3],in[4],in[5],in[6],in[7],in[8],in[9]);
+		if(!good) return -1;
+		uint16_t crc=0xffff^in[7];
+		for(unsigned b=0;b<8;++b) crc=(crc&1)?(crc>>1)^0x8408:crc>>1;
+		valid[trial]=!(in[3]&0xa0) && crc==(uint16_t)(in[8]|(in[9]<<8));
+		ids[trial]=in[7];
+	}
+	bool ok=valid[0] && valid[1] && ids[0]==0x56 && ids[1]==0x52;
+	printf("RENOIR GSI SPI ID: id=%02x%02x crc=%d/%d expected5652=%d; no touch events\n",ids[0],ids[1],valid[0],valid[1],ok);
+	return ok?1:0;
+}
