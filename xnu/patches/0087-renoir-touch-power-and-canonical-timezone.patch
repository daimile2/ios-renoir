+/* Vendor power ordering: IOVDD first, 1ms, then AVDD; caller holds reset low. */
+int
+renoir_touch_power(void)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) return EBUSY;
+	int error = EIO;
+	uint32_t iovdd = 0, avdd = 0;
+	if (rh_poisoned) goto done;
+	error = rh_map();
+	if (!error) error = rh_lookup("ldoc2", &iovdd);
+	if (!error) error = rh_lookup("ldoc7", &avdd);
+	if (!error && iovdd == avdd) error = EINVAL;
+	if (!error) error = rh_send(iovdd, 1800);
+	if (!error) { delay(1000); error = rh_send(avdd, 3300); }
+done:
+	printf("RENOIR RPMH: touch power request errno=%d; not a voltage measurement\n", error);
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
