+/* Pinned HackiOS focaltech_report pattern: remember contacts and release
+ * missing IDs. Renoir samples reach 8635/19160: native axes are 8 subpixels
+ * per panel pixel, unlike redwood's 10800/24000 report extent.
+ * Validate the complete frame before emitting any HID transitions. */
+static struct { bool down; unsigned x,y; } renoir_contacts[10];
+
+static void
+renoir_gpio_hid_release(void)
+{
+	for(unsigned id=0;id<10;++id) if(renoir_contacts[id].down) {
+		sweet_hid_touch(id,0,renoir_contacts[id].x,renoir_contacts[id].y);
+		renoir_contacts[id].down=false;
+	}
+}
+
+static bool
+renoir_gpio_hid_report(const uint8_t *buf)
+{
+	bool seen[10]={0},down[10]={0};
+	unsigned xs[10]={0},ys[10]={0},active=0,count=buf[2]&15;
+	if(count>10) return false;
+	for(unsigned i=0;i<10;++i) {
+		unsigned off=6*i,id=buf[5+off]>>4;
+		if(id>=10) break;
+		unsigned flag=buf[3+off]>>6;
+		unsigned x=((buf[3+off]&15)<<11)+(buf[4+off]<<3)+((buf[7+off]&0xe0)>>5);
+		unsigned y=((buf[5+off]&15)<<11)+(buf[6+off]<<3)+((buf[7+off]&0x1c)>>2);
+		if(seen[id] || flag==3) return false;
+		seen[id]=true;
+		if(flag==1) continue; /* UP uses the last accepted position. */
+		if(x>=1080*8 || y>=2400*8) return false;
+		down[id]=true; xs[id]=x/8; ys[id]=y/8; ++active;
+	}
+	if(active!=count) return false;
+	/* Release old/missing contacts first, then post down/move events. */
+	for(unsigned id=0;id<10;++id) if(renoir_contacts[id].down && !down[id]) {
+		sweet_hid_touch(id,0,renoir_contacts[id].x,renoir_contacts[id].y);
+		renoir_contacts[id].down=false;
+	}
+	for(unsigned id=0;id<10;++id) if(down[id]) {
+		sweet_hid_touch(id,1,xs[id],ys[id]);
+		renoir_contacts[id].down=true;
+		renoir_contacts[id].x=xs[id]; renoir_contacts[id].y=ys[id];
+	}
+	return true;
+}
